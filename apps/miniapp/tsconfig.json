{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["vite/client"],
		"paths": {
			"@voolo/shared": ["../../packages/shared/src/index.ts"],
			"@voolo/shared/*": ["../../packages/shared/src/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
