# ─────────────────────────────────────────────────────────────────────────
# Voolo — пример окружения. Скопируйте в .env (он в .gitignore).
# В проде значения кладутся через `wrangler secret put`, НЕ в wrangler.toml.
# ─────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Отдельный для dev и для prod.
BOT_TOKEN=
# Username бота без @ — используется для сборки deep-link'ов.
BOT_USERNAME=voolo_dev_bot
# Произвольная строка от 32 символов. Передаётся в setWebhook как secret_token
# и проверяется на входе в заголовке X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес Mini App. Локально — адрес cloudflared-туннеля.
MINIAPP_URL=
# Короткое имя direct-link приложения из /newapp: t.me/<bot>/<short_name>
MINIAPP_SHORT_NAME=app

# ── Travelpayouts (Aviasales Data API) ───────────────────────────────────
# Токен: https://app.travelpayouts.com/profile/api-token
TP_TOKEN=
# Партнёрский marker — без него не начисляются комиссии по ссылкам.
TP_MARKER=

# ── Локализация и валюта ─────────────────────────────────────────────────
DEFAULT_LOCALE=ru
DEFAULT_CURRENCY=RUB

# ── Доступ ───────────────────────────────────────────────────────────────
# Telegram user id через запятую. Только они видят админ-команды и рефанды.
ADMIN_USER_IDS=

# ── Наблюдаемость (опционально) ──────────────────────────────────────────
SENTRY_DSN=
